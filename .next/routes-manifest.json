    },
    {
      "page": "/api/launch-data",
      "regex": "^/api/launch\\-data(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/launch\\-data(?:/)?$"
    },
    {
      "page": "/api/rewards/claim",
      "regex": "^/api/rewards/claim(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/rewards/claim(?:/)?$"
    },
    {
      "page": "/api/rewards/pool",
      "regex": "^/api/rewards/pool(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/rewards/pool(?:/)?$"
    },
    {
      "page": "/api/runner/challenge",
      "regex": "^/api/runner/challenge(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/runner/challenge(?:/)?$"
    },
    {
      "page": "/api/runner/leaderboard",
      "regex": "^/api/runner/leaderboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/runner/leaderboard(?:/)?$"
    },
    {
      "page": "/api/runner/start",
      "regex": "^/api/runner/start(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/runner/start(?:/)?$"
    },
    {
      "page": "/api/runner/submit",
      "regex": "^/api/runner/submit(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/runner/submit(?:/)?$"
    },
    {
      "page": "/api/solana-blockhash",
      "regex": "^/api/solana\\-blockhash(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/solana\\-blockhash(?:/)?$"
    },
    {
      "page": "/api/token-data",
      "regex": "^/api/token\\-data(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/token\\-data(?:/)?$"
